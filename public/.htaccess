# RacconMail / Production Configuration
DirectoryIndex index.html index.php
Options -Indexes +FollowSymLinks
RewriteEngine On

# 0. Canonical HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://racconmail.eu/$1 [L,R=301]

# 1. Security: Block sensitive backend directories & db files
RewriteRule ^(bin|config|logs|temp|SQL|vendor|installer)/ - [F,L]
RewriteRule ^installer\.php - [F,L]
RewriteRule \.db$ - [F,L]

# 2. Direct static assets & logo
RewriteRule ^raccoon-logo\.png$ raccoon-logo.png [L]
RewriteRule ^favicon\.ico$ static.php/skins/elastic/images/favicon.ico [L]
RewriteRule ^static\.php(.*)$ static.php$1 [QSA,L]

# 3. Webmail direct shortcuts & Logout redirect
RewriteRule ^logout/?$ api.php?route=auth/logout&redirect=1 [L]
RewriteCond %{QUERY_STRING} _task=logout
RewriteRule ^.*$ https://racconmail.eu/? [R=302,L]

# Redirect ANY legacy Roundcube task/action query string away to /inbox
RewriteCond %{QUERY_STRING} _task= [OR]
RewriteCond %{QUERY_STRING} _action=
RewriteRule ^.*$ /inbox? [R=302,L]

RewriteRule ^inbox/?$ inbox.php [L]
RewriteRule ^webmail/?$ inbox.php [L]
RewriteRule ^mail/?$ inbox.php [L]
RewriteRule ^(login|signin)/?$ inbox.php [L]

# 4. Admin & API routes
RewriteRule ^admin/?$ admin.html [L]
RewriteRule ^api/(.*)$ api.php?route=$1 [QSA,L]
RewriteRule ^api/?$ api.php [QSA,L]

# 5. Landing subpages
RewriteRule ^stories/?$ stories.html [L]
RewriteRule ^news/?$ news.html [L]
RewriteRule ^forum/?$ forum.html [L]
RewriteRule ^auth/?$ auth.html [L]
RewriteRule ^legal/terms/?$ legal_terms.html [L]
RewriteRule ^legal/privacy/?$ legal_privacy.html [L]

# 6. App Downloads
RewriteRule ^downloads/(.*)$ downloads/$1 [L]

# 7. Root explicitly serves landing page
RewriteRule ^$ index.html [L]
RewriteRule ^home/?$ index.html [L]
RewriteRule ^landing/?$ index.html [L]

# 8. Clean fallback
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.html [L]
