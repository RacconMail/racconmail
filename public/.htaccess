Options -Indexes +FollowSymLinks
RewriteEngine On

# 0. Canonical HTTPS & www-to-apex 301 Permanent Redirect (Consolidates all SEO Domain Authority)
RewriteCond %{HTTP_HOST} ^www\.racconmail\.eu$ [NC]
RewriteRule ^(.*)$ https://racconmail.eu/$1 [L,R=301]

RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} (www\.)?racconmail\.eu$ [NC]
RewriteRule ^(.*)$ https://racconmail.eu/$1 [L,R=301]

<IfModule mod_headers.c>
    # Enterprise Security Headers (A+ Trust Score on SecurityHeaders & Google Safe Browsing)
    Header set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" env=HTTPS
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), camera=(), microphone=()"

    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    <FilesMatch "\.(ico|png|svg|webp)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
    AddType image/x-icon .ico
    AddType image/png .png
    AddType image/svg+xml .svg
    AddType application/manifest+json .webmanifest
</IfModule>

# RFC 9116 security.txt
RewriteRule ^\.well-known/security\.txt$ security.txt [L]

# 1. API requests -> api.php
RewriteRule ^api/(.*)$ api.php?route=$1 [QSA,L]
RewriteRule ^api/?$ api.php [QSA,L]

# 2. Legal pages
RewriteRule ^legal/terms/?$ legal_terms.html [L]
RewriteRule ^legal/privacy/?$ legal_privacy.html [L]

# 3. Main frontend pages
RewriteRule ^inbox/?$ inbox.php [L]
RewriteRule ^auth/?$ auth.html [L]
RewriteRule ^admin/?$ admin.html [L]
RewriteRule ^news/?$ news.html [L]
RewriteRule ^stories/?$ stories.html [L]
RewriteRule ^forum/?$ forum.html [L]
RewriteRule ^community/?$ forum.html [L]
